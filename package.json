{
  "name": "openapi-contract-kit",
  "version": "0.0.1",
  "description": "Generate type-safe TypeScript contracts and runtime validators from JSON OpenAPI 3.1 documents.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "openapi-contract-kit": "./dist/bin/openapi-contract-kit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "pack:check": "pnpm run build && pnpm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Clinsmann/openapi-contract-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Clinsmann/openapi-contract-kit/issues"
  },
  "homepage": "https://github.com/Clinsmann/openapi-contract-kit#readme",
  "keywords": [
    "openapi",
    "openapi3",
    "typescript",
    "code-generation",
    "runtime-validation",
    "api-contracts",
    "json-schema",
    "cli"
  ]
}
