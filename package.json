{
  "name": "openapi-contract-kit",
  "version": "0.0.6",
  "description": "Generate type-safe TypeScript contracts and runtime validators from JSON or YAML OpenAPI 3.1 documents.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "openapi-contract-kit": "./dist/bin/openapi-contract-kit.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "import": "./dist/src/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:unit": "vitest run test/generateOpenApiRuntime.test.ts test/model.test.ts --pool=forks",
    "test": "pnpm run build && pnpm run test:unit",
    "pack:check": "pnpm run build && pnpm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Clinsmann/openapi-contract-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Clinsmann/openapi-contract-kit/issues"
  },
  "homepage": "https://github.com/Clinsmann/openapi-contract-kit#readme",
  "keywords": [
    "openapi",
    "openapi3",
    "typescript",
    "code-generation",
    "runtime-validation",
    "api-contracts",
    "json-schema",
    "cli"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
